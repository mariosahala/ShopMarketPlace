<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/rounded_dialog"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingBottom="24dp"
    tools:context=".ui.bottomsheet.ProfileBottomSheetFragment">

    <View
        android:layout_width="48dp"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        android:background="@color/light_grey" />

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/circleImageViewProfile"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="8dp"
        android:src="@drawable/ic_circle"
        app:civ_border_width="0dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Mario Sahala" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="mario.johanes37@gmail.com" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_account_profile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        tools:itemCount="4"
        tools:listitem="@layout/item_section_profile" />

    <Button
        android:id="@+id/btn_add_product_to_cart"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:text="Log Out"
        android:textAllCaps="false" />

</LinearLayout>